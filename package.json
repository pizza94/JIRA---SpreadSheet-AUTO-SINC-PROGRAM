{
  "name": "jira-spreadsheet-automation",
  "version": "2.0.0",
  "private": true,
  "description": "사내 Jira 이슈를 Google Sheets 릴리스 체크리스트에 동기화하는 Windows 데스크톱 앱",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "app": "electron .",
    "dist:win": "electron-builder --win portable",
    "test:snapshot": "node scripts/test-snapshot-rules.mjs",
    "test:sync-mode": "node scripts/test-sync-mode.mjs",
    "test:summary": "node scripts/test-sync-summary.mjs",
    "test:sheet-url": "node scripts/test-google-sheet-url.mjs",
    "test:result-history": "node scripts/test-result-history.mjs",
    "jira:login": "node scripts/jira-login.mjs",
    "jira:scrape": "node scripts/jira-scrape.mjs",
    "sync": "node scripts/sync-jira-to-sheets.mjs"
  },
  "dependencies": {
    "playwright": "^1.61.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.datastreams.jirasheetssync",
    "productName": "Jira Sheets Sync",
    "asar": true,
    "asarUnpack": [
      "scripts/**",
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ],
    "files": [
      "electron/**",
      "scripts/jira-login.mjs",
      "scripts/google-sheet-url.mjs",
      "scripts/sync-mode.mjs",
      "scripts/snapshot-rules.mjs",
      "scripts/result-history.mjs",
      "scripts/sync-summary.mjs",
      "scripts/sync-jira-to-sheets.mjs",
      "package.json",
      "node_modules/playwright/**",
      "node_modules/playwright-core/**"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Jira-Sheets-Sync-${version}.${ext}"
    }
  }
}
